# Copy values into your shell locally, or define them as GitHub repository variables/secrets.
# This file contains placeholders only; never put real credentials here.
CONTENT_NICHE=all
VIDEO_LANGUAGE=en
TIMEZONE=Asia/Kolkata
UPLOAD_PRIVACY=unlisted
DAILY_UPLOAD_ENABLED=false
ALLOW_PUBLIC_UPLOADS=false
DRY_RUN=true
TTS_VOICE=en-us
# Required only after opting into uploads (add as GitHub Secrets, not variables):
YOUTUBE_CLIENT_ID=replace-me
YOUTUBE_CLIENT_SECRET=replace-me
YOUTUBE_REFRESH_TOKEN=replace-me
